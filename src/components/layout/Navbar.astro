---
import { navigationItems, profile } from '@/data/profile';
import MobileMenu from './MobileMenu';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header
  class="no-print sticky top-0 z-50 border-b border-slate-400/10 bg-obsidian-900/80 backdrop-blur-xl"
>
  <div class="mx-auto flex h-[72px] max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Identity -->
    <a
      href="/"
      class="group flex items-center gap-3 focus:outline-none"
      aria-label={`${profile.name} — Home`}
    >
      <div
        class="relative flex h-10 w-10 items-center justify-center rounded-xl border border-accent-blue/40 bg-obsidian-800 font-mono text-sm font-bold text-slate-50 shadow-glow-blue transition-transform duration-200 group-hover:scale-105"
      >
        <span>MK</span>
        <span
          class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full border-2 border-obsidian-900 bg-accent-emerald"
          title="Kubestronaut Control Plane Online"></span>
      </div>
      <div class="flex flex-col">
        <span
          class="text-sm font-bold tracking-tight text-slate-50 group-hover:text-accent-cyan transition-colors"
        >
          {profile.name}
        </span>
        <span class="font-mono text-[11px] text-slate-400">
          Platform Engineer · <span class="text-accent-cyan">Kubestronaut</span>
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label="Primary Navigation" class="hidden lg:flex lg:items-center lg:gap-1">
      {
        navigationItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'relative rounded-lg px-3.5 py-2 text-sm font-medium transition-all duration-200',
                active
                  ? 'bg-accent-blue/15 text-slate-50 shadow-[inset_0_1px_0_0_rgba(59,130,246,0.35)]'
                  : 'text-slate-400 hover:bg-obsidian-800/70 hover:text-slate-50',
              ]}
            >
              {item.label}
              {active && (
                <span
                  aria-hidden="true"
                  class="absolute inset-x-3 -bottom-[1px] h-[2px] rounded-full bg-gradient-to-r from-accent-blue to-accent-cyan"
                />
              )}
            </a>
          );
        })
      }
    </nav>

    <!-- Desktop Action CTA -->
    <div class="hidden lg:flex lg:items-center lg:gap-3">
      <a
        href={profile.resumeUrl}
        download
        class="inline-flex items-center gap-2 rounded-xl border border-accent-cyan/35 bg-obsidian-800/90 px-4 py-2 font-mono text-xs font-semibold text-accent-cyan transition-all duration-200 hover:border-accent-cyan hover:bg-accent-cyan/10"
      >
        <span>CV.pdf</span>
        <svg
          class="h-3.5 w-3.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
      </a>
    </div>

    <!-- Mobile Menu Island -->
    <MobileMenu
      client:load
      items={navigationItems}
      currentPath={currentPath}
      resumeUrl={profile.resumeUrl}
    />
  </div>
</header>
