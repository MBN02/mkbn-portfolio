---
import { profile, navigationItems, socialLinks } from '@/data/profile';
const currentYear = new Date().getFullYear();
---

<footer class="no-print relative z-10 mt-24 border-t border-slate-400/15 bg-obsidian-900/95">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
      <!-- Brand Column -->
      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <div
            class="flex h-9 w-9 items-center justify-center rounded-xl border border-accent-blue/40 bg-obsidian-800 font-mono text-sm font-bold text-slate-50"
          >
            MK
          </div>
          <div>
            <p class="text-base font-bold text-slate-50">{profile.name}</p>
            <p class="font-mono text-xs text-accent-cyan">{profile.title}</p>
          </div>
        </div>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-slate-400">
          Architecting resilient Red Hat OpenShift &amp; Kubernetes platforms, Internal Developer
          Platforms (Port), declarative GitOps pipelines, and autonomous AI SRE systems.
        </p>
        <div
          class="mt-6 inline-flex items-center gap-2.5 rounded-full border border-accent-emerald/30 bg-obsidian-800/80 px-3.5 py-1.5 font-mono text-xs text-slate-50"
        >
          <span class="h-2 w-2 rounded-full bg-accent-emerald animate-pulse"></span>
          <span>Bangalore, India · Open to Principal / Staff Platform &amp; SRE Leadership</span>
        </div>
      </div>

      <!-- Navigation Column -->
      <div class="md:col-span-3">
        <h2 class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-50">
          Architecture &amp; Routes
        </h2>
        <ul class="mt-4 space-y-2.5">
          {
            navigationItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-slate-400 transition-colors hover:text-accent-cyan"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Verified Profiles & Credentials -->
      <div class="md:col-span-4">
        <h2 class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-50">
          Verified Profiles &amp; Channels
        </h2>
        <ul class="mt-4 space-y-2.5">
          {
            socialLinks.map((social) => (
              <li>
                <a
                  href={social.url}
                  target={social.url.startsWith('mailto:') ? undefined : '_blank'}
                  rel={social.url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                  class="group flex items-center justify-between rounded-lg border border-slate-400/10 bg-obsidian-800/50 px-3.5 py-2 text-xs transition-colors hover:border-accent-blue/40 hover:bg-obsidian-800"
                >
                  <span class="font-medium text-slate-50 group-hover:text-accent-cyan">
                    {social.label}
                  </span>
                  <span class="font-mono text-slate-400">{social.handle}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-400/10 pt-8 text-xs text-slate-400 sm:flex-row"
    >
      <p>
        &copy; {currentYear}
        {profile.name} ({profile.brandName}). Engineered with Astro, TypeScript &amp; Tailwind CSS
        on Cloudflare Pages.
      </p>
      <div class="flex items-center gap-4 font-mono text-[11px]">
        <a href="/sitemap-index.xml" class="hover:text-accent-cyan">Sitemap</a>
        <span>·</span>
        <a
          href={profile.credlyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent-cyan"
        >
          Credly Verification
        </a>
        <span>·</span>
        <a href={profile.resumeUrl} download class="hover:text-accent-cyan"> Download Bio PDF </a>
      </div>
    </div>
  </div>
</footer>
