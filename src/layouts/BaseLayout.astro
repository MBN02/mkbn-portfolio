---
import '@/styles/global.css';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import { profile } from '@/data/profile';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  updatedTime?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = profile.shortBio,
  canonicalPath = Astro.url.pathname,
  ogImage = '/images/og-cover.png',
  ogType = 'website',
  publishedTime,
  updatedTime,
  structuredData,
  noindex = false,
} = Astro.props;

const fullTitle = title
  ? `${title} | ${profile.name} — Senior Platform Engineer & Kubestronaut`
  : `${profile.name} — Senior Platform Engineer, SRE Lead & CNCF Kubestronaut`;

const canonicalUrl = canonicalPath.startsWith('http')
  ? canonicalPath
  : new URL(canonicalPath, profile.domain).toString();

const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, profile.domain).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.brandName,
  jobTitle: 'Senior Platform Engineer & SRE Lead',
  url: profile.domain,
  image: new URL(profile.portraitUrl, profile.domain).toString(),
  email: `mailto:${profile.primaryEmail}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bangalore',
    addressCountry: 'IN',
  },
  sameAs: [
    profile.linkedinUrl,
    profile.githubUrl,
    profile.youtubeUrl,
    profile.credlyUrl,
    profile.blogDomain,
  ],
  knowsAbout: [
    'Kubernetes',
    'Red Hat OpenShift',
    'Platform Engineering',
    'Site Reliability Engineering',
    'GitOps',
    'Argo CD',
    'Tekton',
    'Port Internal Developer Platform',
    'Terraform',
    'Google Cloud Platform',
    'Microsoft Azure',
    'HashiCorp Vault',
    'Prometheus',
  ],
};

const schemas = Array.isArray(structuredData)
  ? [personSchema, ...structuredData]
  : structuredData
    ? [personSchema, structuredData]
    : [personSchema];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#080B12" />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:site_name" content={`${profile.name} // ${profile.brandName}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@nk_mohan" />
    <meta name="twitter:creator" content="@nk_mohan" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemas)} />
  </head>
  <body
    class="min-h-screen flex flex-col bg-obsidian-900 text-slate-50 antialiased selection:bg-accent-blue/30 selection:text-slate-50"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-accent-cyan focus:px-4 focus:py-2.5 focus:font-mono focus:text-sm focus:font-bold focus:text-obsidian-900"
    >
      Skip to main content
    </a>

    <!-- Top Scroll Progress Telemetry Beam -->
    <div
      aria-hidden="true"
      class="no-print pointer-events-none fixed inset-x-0 top-0 z-[60] h-[2px] bg-transparent"
    >
      <div
        id="scroll-progress-beam"
        class="h-full w-0 bg-gradient-to-r from-accent-blue via-accent-cyan to-accent-emerald shadow-[0_0_12px_rgba(34,211,238,0.8)] transition-[width] duration-75 ease-out"
      >
      </div>
    </div>

    <!-- Ambient background grid & animated aurora lighting -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 blueprint-grid opacity-70">
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-x-0 top-0 z-0 h-[560px] bg-radial-glow"
    >
    </div>
    <div
      aria-hidden="true"
      class="aurora-orb pointer-events-none fixed -top-32 left-1/4 z-0 h-96 w-96 rounded-full bg-accent-blue/10 blur-3xl"
    >
    </div>
    <div
      aria-hidden="true"
      class="aurora-orb pointer-events-none fixed top-64 right-1/4 z-0 h-80 w-80 rounded-full bg-accent-cyan/8 blur-3xl"
      style="animation-delay: -5s;"
    >
    </div>

    <Navbar currentPath={Astro.url.pathname} />

    <main id="main-content" class="relative z-10 flex-grow">
      <slot />
    </main>

    <Footer />

    <!-- Global Interactive Card Spotlight, 3D Micro-Tilt & Scroll Progress Engine -->
    <script is:inline>
      (() => {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const progressBeam = document.getElementById('scroll-progress-beam');

        // 1. Top Scroll Telemetry Progress Bar
        const updateScrollProgress = () => {
          if (!progressBeam) return;
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          const docHeight =
            document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const pct = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
          progressBeam.style.width = `${pct}%`;
        };
        window.addEventListener('scroll', updateScrollProgress, { passive: true });
        updateScrollProgress();

        if (prefersReducedMotion) return;

        // 2. Cursor-Tracking Surface Spotlight & Subtle 3D Perspective Micro-Tilt
        // Uses a WeakSet so zero DOM attributes are mutated prior to React island hydration
        const boundCards = new WeakSet();
        const bindInteractiveCards = () => {
          const cards = document.querySelectorAll('.glass-card-interactive, .glass-panel');
          cards.forEach((card) => {
            if (boundCards.has(card)) return;
            boundCards.add(card);

            const isInteractive = card.classList.contains('glass-card-interactive');

            card.addEventListener(
              'mousemove',
              (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                card.style.setProperty('--mouse-x', `${x}px`);
                card.style.setProperty('--mouse-y', `${y}px`);
                card.style.setProperty('--spotlight-opacity', '1');

                if (isInteractive && rect.width > 0 && rect.height > 0) {
                  const normX = (x / rect.width - 0.5) * 2;
                  const normY = (y / rect.height - 0.5) * 2;
                  card.style.setProperty('--rx', `${(-normY * 2.2).toFixed(2)}deg`);
                  card.style.setProperty('--ry', `${(normX * 2.2).toFixed(2)}deg`);
                }
              },
              { passive: true }
            );

            card.addEventListener(
              'mouseleave',
              () => {
                card.style.setProperty('--spotlight-opacity', '0');
                card.style.setProperty('--rx', '0deg');
                card.style.setProperty('--ry', '0deg');
              },
              { passive: true }
            );
          });
        };

        // 3. Scroll-Triggered Spring Glide on Below-the-Fold Static Cards
        const initScrollSpring = () => {
          const targets = document.querySelectorAll(
            'section:not(:first-of-type) .glass-card-interactive, section:not(:first-of-type) .glass-panel'
          );
          if (!('IntersectionObserver' in window)) return;

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.style.setProperty('--scroll-offset', '0px');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08, rootMargin: '0px 0px -20px 0px' }
          );

          targets.forEach((el, index) => {
            if (el.closest('astro-island')) return;
            const rect = el.getBoundingClientRect();
            if (rect.top > window.innerHeight) {
              el.classList.add('scroll-spring-card');
              el.style.setProperty('--scroll-offset', '22px');
              el.style.transitionDelay = `${(index % 3) * 55}ms`;
              observer.observe(el);
            }
          });
        };

        bindInteractiveCards();
        initScrollSpring();
      })();
    </script>
  </body>
</html>
