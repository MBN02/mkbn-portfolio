---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Route or Pod Not Found"
  description="The requested route could not be scheduled on this control plane."
  noindex={true}
>
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="glass-panel rounded-3xl border border-accent-cyan/30 p-8 sm:p-12">
        <span class="section-badge">HTTP 404 // POD_NOT_FOUND</span>
        <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-slate-50 sm:text-5xl">
          Route Failed Readiness Probe
        </h1>
        <p class="mt-3 text-base text-slate-400">
          The requested URL does not match any active Ingress or OpenShift Route in the <code
            class="font-mono text-accent-cyan">mkbn.in</code
          > namespace.
        </p>

        <!-- Diagnostic Terminal Output -->
        <div
          class="mt-8 rounded-2xl border border-slate-400/15 bg-obsidian-900 p-5 text-left font-mono text-xs"
        >
          <div
            class="mb-2 flex items-center justify-between border-b border-slate-400/10 pb-2 text-slate-400"
          >
            <span class="text-accent-cyan">oc describe route requested-page -n mkbn-prod</span>
            <span class="text-red-400">Status: ImagePullBackOff / 404</span>
          </div>
          <pre
            class="overflow-x-auto text-slate-400 leading-relaxed"><code>$ kubectl get ingress,routes -n mkbn-prod
Error from server (NotFound): routes.route.openshift.io "requested-path" not found
Suggestion: Reconcile navigation state using one of the healthy routes below.</code></pre>
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a href="/" class="btn-primary">
            <span>Return to Control Plane Home</span>
            <span>→</span>
          </a>
          <a href="/projects" class="btn-secondary">
            <span>Explore Case Studies</span>
          </a>
          <a href="/blog" class="btn-secondary">
            <span>Read Engineering Blog</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
