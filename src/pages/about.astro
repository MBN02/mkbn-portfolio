---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profile, socialLinks } from '@/data/profile';
import { experience } from '@/data/experience';
---

<BaseLayout
  title="About & Career Journey"
  description="Engineering career story of Mohan Kumar BN — Senior Platform Engineer at Henkel, ex-OpsRamp & Hewlett Packard Enterprise, CNCF Certified Kubestronaut, and creator of MKBN-Tech."
>
  <section class="py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Top Intro Grid -->
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <span class="section-badge">ABOUT // PROFESSIONAL NARRATIVE</span>
          <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-50 sm:text-5xl">
            13+ Years Engineering Mission-Critical Infrastructure &amp; Cloud-Native Platforms
          </h1>

          <div class="mt-6 space-y-4 text-base leading-relaxed text-slate-400">
            {profile.extendedBio.map((paragraph) => <p>{paragraph}</p>)}
          </div>

          <div class="mt-8 flex flex-wrap gap-4">
            <a href={profile.resumeUrl} download class="btn-primary">
              <span>Download Full CV (PDF)</span>
              <span>↓</span>
            </a>
            <a href="/resume" class="btn-secondary">
              <span>Interactive Web Resume</span>
              <span>→</span>
            </a>
            <a
              href={profile.credlyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary"
            >
              <span>Credly Verification ↗</span>
            </a>
          </div>
        </div>

        <!-- Portrait & Quick Facts Card -->
        <div class="lg:col-span-5">
          <div class="glass-panel rounded-3xl p-6">
            <div class="overflow-hidden rounded-2xl border border-slate-400/15 bg-obsidian-900">
              <picture>
                <source srcset="/images/mohan-portrait.webp" type="image/webp" />
                <img
                  src="/images/mohan-portrait.png"
                  alt={profile.name}
                  width="386"
                  height="404"
                  class="mx-auto h-auto w-full object-cover"
                />
              </picture>
            </div>

            <div class="mt-6 space-y-3 border-t border-slate-400/15 pt-5 text-sm">
              <div class="flex justify-between">
                <span class="font-mono text-xs text-slate-400">CURRENT ROLE</span>
                <span class="font-semibold text-slate-50">Senior Platform Engineer @ Henkel</span>
              </div>
              <div class="flex justify-between">
                <span class="font-mono text-xs text-slate-400">LOCATION</span>
                <span class="font-semibold text-slate-50">{profile.location}</span>
              </div>
              <div class="flex justify-between">
                <span class="font-mono text-xs text-slate-400">FLAGSHIP DISTINCTION</span>
                <span class="font-mono text-xs font-bold text-accent-cyan">CNCF Kubestronaut</span>
              </div>
              <div class="flex justify-between">
                <span class="font-mono text-xs text-slate-400">DIRECT EMAIL</span>
                <a
                  href={`mailto:${profile.primaryEmail}`}
                  class="font-mono text-xs text-accent-cyan hover:underline"
                >
                  {profile.primaryEmail}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Areas of Ownership -->
      <div class="mt-20">
        <span class="section-badge">CORE OWNERSHIP &amp; LEADERSHIP</span>
        <h2 class="mt-4 text-3xl font-bold text-slate-50">
          Architectural Pillars &amp; Areas of Ownership
        </h2>
        <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
          {
            profile.areasOfOwnership.map((area) => (
              <div class="glass-panel rounded-2xl p-6">
                <span class="font-mono text-xs font-semibold text-accent-cyan">{area.metrics}</span>
                <h3 class="mt-2 text-xl font-bold text-slate-50">{area.title}</h3>
                <p class="mt-2.5 text-sm leading-relaxed text-slate-400">{area.description}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Full Career Timeline -->
      <div class="mt-24">
        <span class="section-badge">CAREER PROGRESSION // 2012 – PRESENT</span>
        <h2 class="mt-4 text-3xl font-bold text-slate-50 sm:text-4xl">
          Engineering Career Journey
        </h2>
        <p class="mt-2 max-w-2xl text-base text-slate-400">
          From foundational enterprise networking and server engineering at Cisco and Dell to
          leading multi-cloud DevOps, SRE, and OpenShift Platform Engineering at Hewlett Packard
          Enterprise, OpsRamp, and Henkel.
        </p>

        <div class="mt-12 space-y-8">
          {
            experience.map((job, idx) => (
              <article class="glass-panel relative rounded-2xl p-6 sm:p-8">
                <div class="flex flex-col justify-between gap-4 border-b border-slate-400/15 pb-5 md:flex-row md:items-center">
                  <div>
                    <div class="flex flex-wrap items-center gap-2.5">
                      <span class="font-mono text-xs font-bold text-accent-cyan">
                        0{idx + 1} // {job.period}
                      </span>
                      {job.current && (
                        <span class="rounded-full border border-accent-emerald/40 bg-accent-emerald/15 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-accent-emerald">
                          CURRENT ROLE
                        </span>
                      )}
                    </div>
                    <h3 class="mt-2 text-2xl font-bold text-slate-50">{job.role}</h3>
                    <p class="mt-0.5 text-sm font-medium text-slate-400">
                      <span class="text-slate-50">{job.company}</span>
                      {job.parentOrPartner && <span> ({job.parentOrPartner})</span>} ·{' '}
                      {job.location}
                    </p>
                  </div>

                  <div class="flex flex-wrap gap-1.5">
                    {job.domains.map((dom) => (
                      <span class="rounded-lg border border-accent-blue/30 bg-obsidian-900/90 px-3 py-1 font-mono text-xs text-accent-cyan">
                        {dom}
                      </span>
                    ))}
                  </div>
                </div>

                <p class="mt-5 text-sm sm:text-base leading-relaxed text-slate-50">{job.summary}</p>

                <ul class="mt-4 space-y-2.5 text-sm text-slate-400">
                  {job.keyAchievements.map((bullet) => (
                    <li class="flex items-start gap-2.5">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-cyan" />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>

                <div class="mt-6 flex flex-wrap gap-1.5 border-t border-slate-400/10 pt-4">
                  {job.technologies.map((tech) => (
                    <span class="rounded-md border border-slate-400/15 bg-obsidian-900 px-2.5 py-1 font-mono text-xs text-slate-400">
                      {tech}
                    </span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Knowledge Sharing & Academic Foundation -->
      <div class="mt-20 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <!-- Knowledge Sharing -->
        <div class="glass-panel rounded-2xl p-7">
          <span class="section-badge">COMMUNITY &amp; MENTORSHIP</span>
          <h2 class="mt-4 text-2xl font-bold text-slate-50">
            MKBN-Tech &amp; Microsoft Certified Trainer Alumni
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-400">
            Sharing engineering knowledge has been a core pillar of my career—both as a <strong
              class="text-slate-50">4-year Microsoft Certified Trainer (MCT, 2020–2024)</strong
            > mentoring cloud engineers and as the creator of <strong class="text-slate-50"
              >MKBN-Tech</strong
            > on YouTube (<strong class="text-accent-cyan">700+ subscribers · 45K+ views</strong>)
            and <a
              href="https://www.mkbntech.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent-cyan underline">mkbntech.com</a
            >.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/videos" class="btn-secondary text-xs"> Explore Video Hub → </a>
            <a href="/blog" class="btn-secondary text-xs"> Read Technical Blog → </a>
          </div>
        </div>

        <!-- Education -->
        <div class="glass-panel rounded-2xl p-7">
          <span class="section-badge">ACADEMIC QUALIFICATION</span>
          <h2 class="mt-4 text-2xl font-bold text-slate-50">
            Engineering Education &amp; Programs
          </h2>
          <div class="mt-5 space-y-4">
            {
              profile.education.map((edu) => (
                <div class="rounded-xl border border-slate-400/15 bg-obsidian-900/80 p-4">
                  <p class="text-base font-bold text-slate-50">{edu.degree}</p>
                  <p class="mt-1 font-mono text-xs text-accent-cyan">
                    {edu.institution} · {edu.location}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
