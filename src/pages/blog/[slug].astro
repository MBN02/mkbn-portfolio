---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArchitectureDiagram from '@/components/ui/ArchitectureDiagram.astro';
import { getCollection } from 'astro:content';
import { profile } from '@/data/profile';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await post.render();

const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => {
    const aSameCat = a.data.category === post.data.category ? 1 : 0;
    const bSameCat = b.data.category === post.data.category ? 1 : 0;
    return bSameCat - aSameCat;
  })
  .slice(0, 3);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt,
  dateModified: post.data.updatedAt || post.data.publishedAt,
  author: {
    '@type': 'Person',
    name: profile.name,
    url: profile.domain,
  },
  publisher: {
    '@type': 'Organization',
    name: profile.brandName,
    url: profile.domain,
  },
  mainEntityOfPage: `${profile.domain}/blog/${post.slug}`,
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.publishedAt}
  updatedTime={post.data.updatedAt}
  structuredData={articleSchema}
>
  <article class="py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-6 font-mono text-xs text-slate-400">
        <a href="/" class="hover:text-accent-cyan">Home</a>
        <span class="mx-2">/</span>
        <a href="/blog" class="hover:text-accent-cyan">Blog</a>
        <span class="mx-2">/</span>
        <span class="text-accent-cyan">{post.data.category}</span>
      </nav>

      <!-- Article Header -->
      <header class="glass-panel rounded-3xl p-6 sm:p-10">
        <div class="flex flex-wrap items-center justify-between gap-3 font-mono text-xs">
          <span
            class="rounded-lg border border-accent-blue/35 bg-accent-blue/15 px-3 py-1 font-semibold text-accent-cyan"
          >
            {post.data.category}
          </span>
          <div class="flex items-center gap-4 text-slate-400">
            <time datetime={post.data.publishedAt}>Published: {post.data.publishedAt}</time>
            <span>·</span>
            <span>{post.data.readingTime}</span>
          </div>
        </div>

        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-50 sm:text-5xl">
          {post.data.title}
        </h1>
        <p class="mt-3 text-base sm:text-lg leading-relaxed text-slate-400">
          {post.data.description}
        </p>

        <!-- Author & Canonical Metadata Bar -->
        <div
          class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-slate-400/15 pt-5"
        >
          <div class="flex items-center gap-3">
            <img
              src="/images/mohan-portrait.png"
              alt={profile.name}
              width="44"
              height="44"
              class="h-11 w-11 rounded-full border border-accent-cyan/40 object-cover"
            />
            <div>
              <p class="text-sm font-bold text-slate-50">{profile.name}</p>
              <p class="font-mono text-xs text-accent-cyan">{profile.title}</p>
            </div>
          </div>

          <div class="flex flex-wrap gap-2.5">
            {
              post.data.githubRepoUrl && (
                <a
                  href={post.data.githubRepoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-secondary py-2 px-4 text-xs"
                >
                  <span>GitHub Code ↗</span>
                </a>
              )
            }
            <a
              href={post.data.canonicalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary py-2 px-4 text-xs"
            >
              <span>Full Guide on MKBN-Tech ↗</span>
            </a>
          </div>
        </div>
      </header>

      <!-- Main Layout: Content + Sticky Sidebar TOC -->
      <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-12">
        <div class="lg:col-span-8 space-y-8">
          <!-- Optional Architecture Diagram -->
          {
            post.data.architectureDiagram && (
              <ArchitectureDiagram
                title="Blueprint Topology"
                mermaidCode={post.data.architectureDiagram}
              />
            )
          }

          <!-- Companion YouTube Video (Privacy-First Click-to-Load) -->
          {
            post.data.youtubeVideoId && (
              <div class="glass-panel rounded-2xl p-6">
                <div class="flex items-center justify-between mb-4">
                  <span class="font-mono text-xs font-bold uppercase tracking-wider text-accent-cyan">
                    ▶ Companion Video Walkthrough (@mkbn-tech)
                  </span>
                  <a
                    href={`https://www.youtube.com/watch?v=${post.data.youtubeVideoId}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-xs text-slate-400 hover:text-accent-cyan"
                  >
                    Open on YouTube ↗
                  </a>
                </div>
                <div
                  class="yt-lazy-embed relative aspect-video cursor-pointer overflow-hidden rounded-xl border border-slate-400/20 bg-obsidian-900"
                  data-video-id={post.data.youtubeVideoId}
                >
                  <img
                    src={`https://i.ytimg.com/vi/${post.data.youtubeVideoId}/hqdefault.jpg`}
                    alt={`Watch video tutorial for ${post.data.title}`}
                    width="480"
                    height="360"
                    loading="lazy"
                    class="h-full w-full object-cover opacity-85 transition-opacity hover:opacity-100"
                  />
                  <button
                    type="button"
                    aria-label="Load privacy-enhanced YouTube video player"
                    class="absolute inset-0 flex items-center justify-center bg-obsidian-900/40"
                  >
                    <span class="inline-flex items-center gap-2 rounded-full bg-accent-cyan px-5 py-3 font-mono text-xs font-bold text-obsidian-900 shadow-glow-cyan">
                      ▶ Load Video Player (Privacy Mode)
                    </span>
                  </button>
                </div>
              </div>
            )
          }

          <!-- MDX Article Body -->
          <div class="glass-panel rounded-3xl p-6 sm:p-10">
            <div
              id="article-prose"
              class="prose prose-invert prose-slate max-w-none prose-headings:scroll-mt-24 prose-headings:text-slate-50 prose-a:text-accent-cyan prose-code:text-accent-cyan prose-pre:relative prose-pre:border prose-pre:border-slate-400/15 prose-pre:bg-obsidian-900"
            >
              <Content />
            </div>
          </div>
        </div>

        <!-- Sticky Sidebar: Table of Contents & Share -->
        <aside class="lg:col-span-4 space-y-6">
          <div class="glass-panel sticky top-24 rounded-2xl p-6">
            <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-accent-cyan">
              Table of Contents
            </h2>
            {
              headings.length > 0 ? (
                <ul class="mt-4 space-y-2.5 text-xs">
                  {headings.map((h) => (
                    <li class={h.depth > 2 ? 'pl-4' : ''}>
                      <a
                        href={`#${h.slug}`}
                        class="text-slate-400 transition-colors hover:text-accent-cyan"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="mt-3 text-xs text-slate-400">Technical Blueprint Overview</p>
              )
            }

            <div class="mt-6 border-t border-slate-400/15 pt-5">
              <p class="font-mono text-[11px] uppercase tracking-wider text-slate-400">Tags</p>
              <div class="mt-2.5 flex flex-wrap gap-1.5">
                {
                  post.data.tags.map((tag) => (
                    <span class="rounded border border-slate-400/15 bg-obsidian-900 px-2.5 py-1 font-mono text-xs text-slate-50">
                      #{tag}
                    </span>
                  ))
                }
              </div>
            </div>

            <div class="mt-6 border-t border-slate-400/15 pt-5">
              <p class="font-mono text-[11px] uppercase tracking-wider text-slate-400">
                Share Blueprint
              </p>
              <div class="mt-2.5 flex gap-2">
                <a
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`${profile.domain}/blog/${post.slug}`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg border border-slate-400/20 bg-obsidian-900 px-3 py-1.5 font-mono text-xs text-slate-50 hover:border-accent-cyan"
                >
                  Share on LinkedIn ↗
                </a>
              </div>
            </div>
          </div>
        </aside>
      </div>

      <!-- Related Articles -->
      <section class="mt-16">
        <h2 class="text-2xl font-bold text-slate-50">Related Engineering Blueprints</h2>
        <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3">
          {
            relatedPosts.map((rel) => (
              <article class="glass-card-interactive rounded-2xl p-6">
                <span class="font-mono text-xs text-accent-cyan">{rel.data.category}</span>
                <h3 class="mt-2 text-lg font-bold text-slate-50">
                  <a href={`/blog/${rel.slug}`} class="hover:text-accent-cyan">
                    {rel.data.title}
                  </a>
                </h3>
                <p class="mt-2 text-xs text-slate-400 line-clamp-3">{rel.data.description}</p>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </article>

  <script>
    // 1. Add Copy-Code buttons to all <pre> blocks inside #article-prose
    const preBlocks = document.querySelectorAll('#article-prose pre');
    preBlocks.forEach((pre) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className =
        'absolute top-2.5 right-2.5 rounded-lg border border-slate-400/25 bg-obsidian-800/90 px-2.5 py-1 font-mono text-[11px] text-accent-cyan hover:border-accent-cyan';
      btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.innerText || '';
        await navigator.clipboard.writeText(code);
        btn.textContent = 'Copied!';
        setTimeout(() => {
          btn.textContent = 'Copy';
        }, 1800);
      });
      pre.appendChild(btn);
    });

    // 2. Privacy-conscious click-to-play YouTube embed
    document.querySelectorAll('.yt-lazy-embed').forEach((el) => {
      el.addEventListener('click', () => {
        const videoId = el.getAttribute('data-video-id');
        if (!videoId) return;
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
        iframe.title = 'YouTube video player';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.className = 'h-full w-full border-0';
        el.innerHTML = '';
        el.appendChild(iframe);
      });
    });
  </script>
</BaseLayout>
