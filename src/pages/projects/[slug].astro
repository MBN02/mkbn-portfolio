---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArchitectureDiagram from '@/components/ui/ArchitectureDiagram.astro';
import { getCollection } from 'astro:content';
import { profile } from '@/data/profile';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: profile.domain,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Projects',
      item: `${profile.domain}/projects`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: project.data.title,
      item: `${profile.domain}/projects/${project.slug}`,
    },
  ],
};
---

<BaseLayout
  title={project.data.title}
  description={project.data.architectureSummary}
  ogType="article"
  structuredData={breadcrumbSchema}
>
  <article class="py-12 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-6 font-mono text-xs text-slate-400">
        <a href="/" class="hover:text-accent-cyan">Home</a>
        <span class="mx-2">/</span>
        <a href="/projects" class="hover:text-accent-cyan">Projects</a>
        <span class="mx-2">/</span>
        <span class="text-accent-cyan">{project.data.category}</span>
      </nav>

      <!-- Case Study Hero Header -->
      <header class="glass-panel rounded-3xl p-6 sm:p-10">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <span class="section-badge">{project.data.category}</span>
          <span class="font-mono text-xs text-slate-400">
            {project.data.environmentScope}
          </span>
        </div>

        <h1 class="mt-5 text-3xl font-extrabold tracking-tight text-slate-50 sm:text-5xl">
          {project.data.title}
        </h1>
        <p class="mt-3 text-lg text-slate-400">{project.data.subtitle}</p>

        <div
          class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-slate-400/15 pt-5"
        >
          <div>
            <span class="font-mono text-[11px] uppercase tracking-wider text-slate-400">
              ROLE &amp; OWNERSHIP
            </span>
            <p class="font-mono text-xs font-semibold text-accent-cyan">
              {project.data.role}
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            {
              project.data.githubUrl && (
                <a
                  href={project.data.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-secondary py-2 px-4 text-xs"
                >
                  <span>GitHub Repository ↗</span>
                </a>
              )
            }
            {
              project.data.relatedVideoUrl && (
                <a
                  href={project.data.relatedVideoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary py-2 px-4 text-xs"
                >
                  <span>▶ Watch YouTube Walkthrough</span>
                </a>
              )
            }
            {
              project.data.relatedBlogSlug && (
                <a
                  href={`/blog/${project.data.relatedBlogSlug}`}
                  class="btn-secondary py-2 px-4 text-xs"
                >
                  <span>Companion Article →</span>
                </a>
              )
            }
          </div>
        </div>

        <!-- Outcomes Strip -->
        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
          {
            project.data.outcomes.map((outcome) => (
              <div class="rounded-2xl border border-accent-emerald/30 bg-obsidian-900/90 p-4">
                <p class="font-mono text-lg font-extrabold text-accent-emerald">{outcome.metric}</p>
                <p class="mt-1 text-xs leading-relaxed text-slate-400">{outcome.description}</p>
              </div>
            ))
          }
        </div>
      </header>

      <!-- Problem & Business Context -->
      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        <div class="glass-panel rounded-2xl p-6">
          <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-accent-cyan">
            01 // Engineering Problem
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-50">
            {project.data.problemStatement}
          </p>
        </div>
        <div class="glass-panel rounded-2xl p-6">
          <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-accent-violet">
            02 // Business &amp; Operational Context
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-50">
            {project.data.businessContext}
          </p>
        </div>
      </div>

      <!-- Architecture Topology Diagram -->
      <div class="mt-8">
        <ArchitectureDiagram
          title={`Architecture Topology // ${project.data.title}`}
          mermaidCode={project.data.mermaidDiagram}
          nodes={project.data.topologyNodes}
        />
      </div>

      <!-- Key Architectural Decisions & Tradeoffs -->
      <section class="mt-10 glass-panel rounded-3xl p-6 sm:p-8">
        <h2 class="text-2xl font-bold text-slate-50">
          Key Architectural Decisions &amp; Engineering Tradeoffs
        </h2>
        <div class="mt-6 space-y-5">
          {
            project.data.keyDecisions.map((kd, idx) => (
              <div class="rounded-2xl border border-slate-400/15 bg-obsidian-900/85 p-5">
                <p class="font-mono text-xs font-bold text-accent-cyan">DECISION 0{idx + 1}</p>
                <h3 class="mt-1 text-base font-bold text-slate-50">{kd.decision}</h3>
                <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2 text-xs leading-relaxed">
                  <div class="rounded-xl border border-slate-400/10 bg-obsidian-800/70 p-3.5">
                    <span class="font-mono font-semibold text-accent-emerald">
                      ARCHITECTURAL RATIONALE:
                    </span>
                    <p class="mt-1 text-slate-400">{kd.rationale}</p>
                  </div>
                  <div class="rounded-xl border border-slate-400/10 bg-obsidian-800/70 p-3.5">
                    <span class="font-mono font-semibold text-accent-violet">
                      ENGINEERING TRADEOFF:
                    </span>
                    <p class="mt-1 text-slate-400">{kd.tradeoff}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Security & Reliability Guardrails -->
      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        <section class="glass-panel rounded-2xl p-6">
          <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-accent-emerald">
            Zero-Trust Security Guardrails
          </h2>
          <ul class="mt-4 space-y-2.5 text-sm text-slate-400">
            {
              project.data.securityConsiderations.map((sec) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-emerald" />
                  <span>{sec}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="glass-panel rounded-2xl p-6">
          <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-accent-cyan">
            SRE &amp; Reliability Engineering
          </h2>
          <ul class="mt-4 space-y-2.5 text-sm text-slate-400">
            {
              project.data.reliabilityConsiderations.map((rel) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-cyan" />
                  <span>{rel}</span>
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <!-- Long-Form Implementation Deep Dive (MDX Content) -->
      <div class="mt-10 glass-panel rounded-3xl p-6 sm:p-10">
        <div
          class="prose prose-invert prose-slate max-w-none prose-headings:text-slate-50 prose-a:text-accent-cyan prose-code:text-accent-cyan prose-pre:border prose-pre:border-slate-400/15 prose-pre:bg-obsidian-900"
        >
          <Content />
        </div>
      </div>

      <!-- Technology Stack & Footer Navigation -->
      <div class="mt-8 glass-panel rounded-2xl p-6">
        <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-slate-400">
          Complete Technology Stack
        </h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {
            project.data.technologies.map((tech) => (
              <span class="rounded-lg border border-slate-400/15 bg-obsidian-900 px-3 py-1.5 font-mono text-xs text-slate-50">
                {tech}
              </span>
            ))
          }
        </div>
        <div class="mt-6 flex items-center justify-between border-t border-slate-400/15 pt-4">
          <a
            href="/projects"
            class="font-mono text-xs font-semibold text-accent-cyan hover:underline"
          >
            ← Back to All Case Studies
          </a>
          <a
            href="/contact"
            class="font-mono text-xs font-semibold text-slate-50 hover:text-accent-cyan"
          >
            Discuss This Architecture →
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
