---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ui/ContactForm';
import { profile, socialLinks } from '@/data/profile';
---

<BaseLayout
  title="Contact & Executive Inquiries"
  description="Connect with Mohan Kumar BN — Senior Platform Engineer, SRE Lead & CNCF Certified Kubestronaut in Bangalore, India."
>
  <section class="py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <!-- Left Column: Direct Channels & Context -->
        <div class="lg:col-span-5">
          <span class="section-badge">CONTACT // DIRECT CHANNELS</span>
          <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-50 sm:text-5xl">
            Let’s Connect
          </h1>
          <p class="mt-4 text-base leading-relaxed text-slate-400">
            Whether you are hiring for a <strong class="text-slate-50"
              >Senior / Staff / Principal Platform Engineer or SRE Lead</strong
            > role, seeking architectural guidance on <strong class="text-slate-50"
              >Red Hat OpenShift, Kubernetes, Port IDP, or GitOps</strong
            >, or collaborating on <strong class="text-slate-50">MKBN-Tech</strong> content—I’d love to
            hear from you.
          </p>

          <!-- Verified Profiles List -->
          <div class="mt-8 space-y-3">
            {
              socialLinks.map((social) => (
                <a
                  href={social.url}
                  target={social.url.startsWith('mailto:') ? undefined : '_blank'}
                  rel={social.url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                  class="glass-card-interactive flex items-center justify-between rounded-2xl p-4"
                >
                  <div>
                    <p class="text-sm font-bold text-slate-50">{social.label}</p>
                    <p class="font-mono text-xs text-accent-cyan">{social.handle}</p>
                  </div>
                  <span class="font-mono text-xs text-slate-400">Connect ↗</span>
                </a>
              ))
            }
          </div>

          <div class="mt-8 rounded-2xl border border-accent-emerald/30 bg-obsidian-800/80 p-5">
            <div class="flex items-center gap-2 font-mono text-xs font-bold text-accent-emerald">
              <span class="h-2.5 w-2.5 rounded-full bg-accent-emerald animate-pulse"></span>
              <span>LOCATION &amp; AVAILABILITY</span>
            </div>
            <p class="mt-2 text-sm text-slate-400">
              Based in <strong class="text-slate-50">{profile.location}</strong> (IST / UTC+5:30). Available
              for enterprise platform leadership roles, global remote/hybrid opportunities, and technical
              advisory.
            </p>
          </div>
        </div>

        <!-- Right Column: Interactive Contact Form -->
        <div class="lg:col-span-7">
          <ContactForm
            client:load
            primaryEmail={profile.primaryEmail}
            communityEmail={profile.communityEmail}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
