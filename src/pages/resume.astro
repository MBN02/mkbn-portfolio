---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profile } from '@/data/profile';
import { experience } from '@/data/experience';
import { certifications } from '@/data/certifications';
import { skillDomains } from '@/data/skills';
---

<BaseLayout
  title="Executive Resume & CV"
  description="Interactive web resume and downloadable PDF CV of Mohan Kumar BN — Senior Platform Engineer, SRE Lead, and CNCF Certified Kubestronaut."
>
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <!-- Top Action Bar -->
      <div
        class="no-print mb-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-400/15 bg-obsidian-800/80 p-4 sm:px-6"
      >
        <div>
          <p class="font-mono text-xs text-accent-cyan">DOCUMENT // CURRICULUM_VITAE</p>
          <p class="text-sm text-slate-400">Verified web view &amp; downloadable PDF bio.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <button id="print-resume-btn" type="button" class="btn-secondary text-xs py-2.5 px-4">
            <span>Print View</span>
          </button>
          <a href={profile.resumeUrl} download class="btn-primary text-xs py-2.5 px-5">
            <span>Download Original PDF</span>
            <span>↓</span>
          </a>
        </div>
      </div>

      <!-- Resume Sheet -->
      <div class="glass-panel rounded-3xl p-6 sm:p-12">
        <!-- Header -->
        <div class="border-b border-slate-400/20 pb-8">
          <div class="flex flex-col justify-between gap-6 md:flex-row md:items-center">
            <div>
              <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-50">
                {profile.name}
              </h1>
              <p class="mt-1.5 font-mono text-sm font-semibold text-accent-cyan">
                {profile.title}
              </p>
              <p class="mt-1 text-xs text-slate-400">
                {profile.location} · <a
                  href={`mailto:${profile.primaryEmail}`}
                  class="text-accent-cyan hover:underline">{profile.primaryEmail}</a
                >
              </p>
            </div>
            <div class="flex flex-wrap gap-2 font-mono text-xs">
              <a
                href={profile.linkedinUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-lg border border-slate-400/20 bg-obsidian-900 px-3 py-1.5 text-slate-50 hover:border-accent-cyan"
              >
                LinkedIn ↗
              </a>
              <a
                href={profile.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-lg border border-slate-400/20 bg-obsidian-900 px-3 py-1.5 text-slate-50 hover:border-accent-cyan"
              >
                GitHub ↗
              </a>
              <a
                href={profile.credlyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-lg border border-slate-400/20 bg-obsidian-900 px-3 py-1.5 text-slate-50 hover:border-accent-cyan"
              >
                Credly ↗
              </a>
              <a
                href={profile.youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-lg border border-slate-400/20 bg-obsidian-900 px-3 py-1.5 text-slate-50 hover:border-accent-cyan"
              >
                YouTube (@mkbn-tech) ↗
              </a>
            </div>
          </div>

          <p class="mt-6 text-sm leading-relaxed text-slate-400">
            {profile.shortBio}
          </p>
        </div>

        <!-- Core Competencies Matrix -->
        <div class="mt-8 border-b border-slate-400/20 pb-8">
          <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-accent-cyan">
            Core Technical Competencies
          </h2>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {
              skillDomains.map((domain) => (
                <div class="rounded-xl border border-slate-400/15 bg-obsidian-900/70 p-4">
                  <h3 class="text-sm font-bold text-slate-50">{domain.title}</h3>
                  <p class="mt-1.5 font-mono text-xs text-slate-400">
                    {domain.skills.map((s) => s.name).join(' · ')}
                  </p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Accreditations & Certifications -->
        <div class="mt-8 border-b border-slate-400/20 pb-8">
          <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-accent-cyan">
            Verified Certifications &amp; Accreditations
          </h2>
          <div class="mt-4 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
            {
              certifications.slice(0, 14).map((cert) => (
                <div class="flex items-center justify-between rounded-lg border border-slate-400/10 bg-obsidian-900/60 px-3.5 py-2 text-xs">
                  <span class="font-semibold text-slate-50">{cert.name}</span>
                  <span class="font-mono text-accent-cyan shrink-0 ml-2">{cert.provider}</span>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Career History -->
        <div class="mt-8 border-b border-slate-400/20 pb-8">
          <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-accent-cyan">
            Professional Experience (2012 – Present)
          </h2>
          <div class="mt-6 space-y-8">
            {
              experience.map((job) => (
                <div>
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h3 class="text-lg font-bold text-slate-50">
                      {job.role} — <span class="text-accent-cyan">{job.company}</span>
                    </h3>
                    <span class="font-mono text-xs text-slate-400">
                      {job.period} | {job.location}
                    </span>
                  </div>
                  <p class="mt-2 text-xs sm:text-sm text-slate-400">{job.summary}</p>
                  <ul class="mt-3 space-y-1.5 text-xs sm:text-sm text-slate-400">
                    {job.keyAchievements.map((bullet) => (
                      <li class="flex items-start gap-2">
                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-blue" />
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Education & Community -->
        <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-accent-cyan">
              Academic Qualification
            </h2>
            <ul class="mt-3 space-y-2 text-sm text-slate-400">
              {
                profile.education.map((edu) => (
                  <li>
                    <strong class="text-slate-50">{edu.degree}</strong> — {edu.institution} (
                    {edu.location})
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-accent-cyan">
              Technical Content &amp; Community
            </h2>
            <p class="mt-3 text-sm text-slate-400">
              <strong class="text-slate-50"
                >Technical Content Creator | MKBN-Tech YouTube Channel &amp; Blog</strong
              >: Hands-on production tutorials on Red Hat OpenShift, Platform Engineering, GitOps,
              Kubernetes, and AI SRE (<strong class="text-accent-cyan"
                >700+ subscribers · 45K+ views</strong
              >).
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const printBtn = document.getElementById('print-resume-btn');
    printBtn?.addEventListener('click', () => window.print());
  </script>
</BaseLayout>
